# ============================================================
# YE FILE COPY KARKE ".env" NAAM SE SAVE KARO (backend folder me)
# ============================================================

# ---- MongoDB ----
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas (free cloud): Atlas dashboard > Connect > Drivers > yaha paste karo
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=heatsafe_ai

# ---- JWT secret (login token sign karne ke liye) ----
# Koi bhi lamba random string daal do, kisi ke saath share mat karna
JWT_SECRET_KEY=badlo-ise-kisi-bhi-random-lambe-secret-string-se
JWT_EXPIRE_MINUTES=10080

# ---- Weather ----
# Open-Meteo (jo is project me use ho raha hai) FREE hai, isme KOI API KEY NAHI chahiye.
# Ye field sirf tab bharo agar aage chal ke OpenWeatherMap jaisi paid service add karni ho:
WEATHER_API_KEY=

# Gemini AI assistant (Google AI Studio se key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Default location (agar user location na de to) ----
DEFAULT_LAT=30.3745
DEFAULT_LON=76.1516
DEFAULT_LOCATION_LABEL=Nabha, Punjab

# ---- Frontend jahan se requests aayengi (CORS) ----
FRONTEND_ORIGINS=http://localhost:5173
